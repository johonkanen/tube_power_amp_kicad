		(uuid "f763e5a3-cd78-5b60-a11c-02f3a9b25de3")
	)
	(text "Kelvin: each NetTie sits on its shunt's GND pad; KELVn runs as its own trace to the sense amp's reference (sheet 04) and K n as the signal trace; the shunt's current goes straight to the GND_PWR star."
		(exclude_from_sim no)
		(at 152.4 190.5 0)
		(effects
			(font
